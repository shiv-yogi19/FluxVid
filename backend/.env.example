# Comma-separated list of allowed frontend origins (no trailing slash, never "*")
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io,http://localhost:8080
# Maximum size of a single download, in bytes (default 500 MB)
MAX_DOWNLOAD_SIZE=524288000
# Maximum seconds for one extraction or download
DOWNLOAD_TIMEOUT=300
# Scratch directory for temporary files (cleaned automatically)
TEMP_DIRECTORY=/tmp/fluxvid
# Optional tuning
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_DOWNLOADS=2
# Set to true only when running behind a trusted reverse proxy (uses X-Forwarded-For)
TRUST_PROXY=false
