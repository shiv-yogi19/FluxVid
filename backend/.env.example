# Copy to .env for local runs. On Render, enter these in the dashboard (Environment tab).
# Never commit a real .env file; it is listed in .gitignore.

# Allowed browser origins, comma-separated. Scheme + host only: NO path, NO trailing slash, never "*".
# Correct:   https://shiv-yogi19.github.io
# Incorrect: https://shiv-yogi19.github.io/FluxVid/
FRONTEND_ORIGIN=https://shiv-yogi19.github.io,http://localhost:8080

# Largest file one download may produce, in bytes (262144000 = 250 MB)
MAX_DOWNLOAD_SIZE=262144000
# Seconds one download may run before it is stopped
DOWNLOAD_TIMEOUT=600
# Scratch folder for in-progress and finished files (cleaned automatically)
TEMP_DIRECTORY=/tmp/fluxvid

# Seconds a finished file stays available for your browser to fetch
JOB_TTL=900
# Downloads running at once on the whole server / per visitor
MAX_ACTIVE_JOBS=2
MAX_JOBS_PER_IP=1
# Analyze + start requests per visitor per minute
RATE_LIMIT_PER_MINUTE=30
# true only behind a trusted reverse proxy (Render sets X-Forwarded-For)
TRUST_PROXY=true
# Serve /docs, /redoc and /openapi.json
ENABLE_DOCS=true
